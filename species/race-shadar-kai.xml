<?xml version="1.0" encoding="utf-8" ?>

<elements>

	<info>
		<name>Shadar-kai</name>
		<description>A 2024-compatible implementation of the Shadar-kai species.</description>
		<author url="https://github.com/StealYourCode/Aurora-DND-contents">StealYourCode</author>

		<update version="0.0.1">
			<file name="race-shadar-kai.xml" url="https://raw.githubusercontent.com/StealYourCode/Aurora-DND-contents/main/races/race-shadar-kai.xml" />
		</update>
	</info>

	<element
		name="Shadar-kai"
		type="Race"
		source="StealYourCode - D&D 2024 Custom Content"
		id="ID_STEALYOURCODE_2024_RACE_SHADAR_KAI">

		<description>

			<p>Shadar-kai are elves touched by the Shadowfell and connected to the Raven Queen.</p>

			<h5>SHADAR-KAI TRAITS</h5>

			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Creature Type:</strong> Humanoid</li>
				<li><strong>Size:</strong> Medium</li>
				<li><strong>Speed:</strong> 30 feet</li>
			</ul>

			<p>As a Shadar-kai, you have the following special traits.</p>

			<p class="indent">
				<strong><em>Darkvision.</em></strong>
				You have Darkvision with a range of 60 feet.
			</p>

			<p class="indent">
				<strong><em>Fey Ancestry.</em></strong>
				You have Advantage on saving throws you make to avoid or end the Charmed condition on yourself.
			</p>

			<p class="indent">
				<strong><em>Necrotic Resistance.</em></strong>
				You have Resistance to Necrotic damage.
			</p>

			<p class="indent">
				<strong><em>Trance.</em></strong>
				You don't need to sleep, and magic can't put you to sleep. You can finish a Long Rest in 4 hours if you spend those hours in a trancelike meditation during which you retain consciousness.
			</p>

			<p class="indent">
				<strong><em>Blessing of the Raven Queen.</em></strong>
				As a Bonus Action, you can magically teleport up to 30 feet to an unoccupied space you can see. After you teleport using this trait, you gain Resistance to all damage until the start of your next turn.
			</p>

		</description>

		<sheet display="false" />

		<rules>

			<!-- 2024 species do not provide ability score increases. -->
			<select
				type="Ability Score Improvement"
				name="Ability Score Improvement Option (Shadar-kai)"
				supports="Custom Ability Score Improvement Option"
				requirements="!ID_INTERNAL_GRANTS_BACKGROUND_ASI" />

			<grant type="Size" id="ID_SIZE_MEDIUM" />

			<stat name="innate speed" value="30" bonus="base" />

			<grant
				type="Language"
				id="ID_LANGUAGE_COMMON"
				requirements="!ID_WOTC_TCOE_OPTION_CUSTOMIZED_LANGUAGE" />

			<select
				type="Language"
				name="Language (Shadar-kai)"
				supports="Standard"
				number="1"
				requirements="!ID_WOTC_TCOE_OPTION_CUSTOMIZED_LANGUAGE" />

			<select
				type="Language"
				name="Customized Language (Shadar-kai)"
				supports="Custom Race Language"
				number="2"
				requirements="ID_WOTC_TCOE_OPTION_CUSTOMIZED_LANGUAGE" />

			<grant type="Vision" id="ID_VISION_DARKVISION" />

			<grant
				type="Racial Trait"
				id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_FEY_ANCESTRY" />

			<grant
				type="Racial Trait"
				id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_NECROTIC_RESISTANCE" />

			<grant
				type="Racial Trait"
				id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_TRANCE" />

			<grant
				type="Racial Trait"
				id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_BLESSING_RAVEN_QUEEN" />

		</rules>

	</element>


	<!-- ============================================================ -->
	<!-- Fey Ancestry                                                   -->
	<!-- ============================================================ -->

	<element
		name="Fey Ancestry"
		type="Racial Trait"
		source="StealYourCode - D&D 2024 Custom Content"
		id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_FEY_ANCESTRY">

		<description>
			<p>You have Advantage on saving throws you make to avoid or end the Charmed condition on yourself.</p>
		</description>

	</element>


	<!-- ============================================================ -->
	<!-- Necrotic Resistance                                           -->
	<!-- ============================================================ -->

	<element
		name="Necrotic Resistance"
		type="Racial Trait"
		source="StealYourCode - D&D 2024 Custom Content"
		id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_NECROTIC_RESISTANCE">

		<description>
			<p>You have Resistance to Necrotic damage.</p>
		</description>

		<sheet>
			<description>Resistance to Necrotic damage.</description>
		</sheet>

		<rules>
			<grant
				type="Condition"
				id="ID_INTERNAL_CONDITION_DAMAGE_RESISTANCE_NECROTIC" />
		</rules>

	</element>


	<!-- ============================================================ -->
	<!-- Trance                                                         -->
	<!-- ============================================================ -->

	<element
		name="Trance"
		type="Racial Trait"
		source="StealYourCode - D&D 2024 Custom Content"
		id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_TRANCE">

		<description>
			<p>You don't need to sleep, and magic can't put you to sleep. You can finish a Long Rest in 4 hours if you spend those hours in a trancelike meditation during which you retain consciousness.</p>

			<p>When you finish this trance, you can gain proficiency with two weapons or tools of your choice with which you don't already have proficiency. You retain these proficiencies until you finish your next Long Rest.</p>
		</description>

	</element>

	<!-- ============================================================ -->
	<!-- Blessing of the Raven Queen                                    -->
	<!-- ============================================================ -->

	<element
		name="Blessing of the Raven Queen"
		type="Racial Trait"
		source="StealYourCode - D&D 2024 Custom Content"
		id="ID_STEALYOURCODE_2024_RACIAL_TRAIT_SHADAR_KAI_BLESSING_RAVEN_QUEEN">

		<description>
			<p>As a Bonus Action, you can magically teleport up to 30 feet to an unoccupied space you can see.</p>

			<p>After you teleport using this trait, you gain Resistance to all damage until the start of your next turn.</p>
		</description>

		<sheet
			action="Bonus Action"
			usage="3/Long Rest">

			<description>
				Teleport up to 30 feet to an unoccupied space you can see. After teleporting, you gain Resistance to all damage until the start of your next turn.
			</description>

		</sheet>

		<rules>

			<stat
				name="shadar-kai:blessing raven queen:uses"
				value="3" />

		</rules>

	</element>

</elements>
